{
  "name": "devdeck",
  "private": true,
  "version": "0.4.0-beta.5",
  "type": "module",
  "description": "A local-first development command center for Windows: run your whole stack, watch every service, and jump into any terminal.",
  "license": "MIT",
  "author": "Develtech",
  "homepage": "https://github.com/d3velopm3nt/devdeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3velopm3nt/devdeck.git"
  },
  "bugs": {
    "url": "https://github.com/d3velopm3nt/devdeck/issues"
  },
  "keywords": [
    "tauri",
    "rust",
    "react",
    "developer-tools",
    "terminal",
    "monorepo",
    "process-manager",
    "local-first"
  ],
  "scripts": {
    "ask": "node scripts/stage-ask.mjs",
    "ask:release": "node scripts/stage-ask.mjs --release",
    "dev": "npm run mobile:voice && npm run ask && vite",
    "build": "npm run mobile:voice && npm run ask:release && tsc -b && vite build",
    "lint": "oxlint && node scripts/check-store-selectors.mjs && node scripts/check-sync-commands.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "mobile:voice": "node scripts/build-mobile-voice.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-react": "^7.0.2",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.33.0",
    "monaco-editor": "^0.56.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "0.28.2",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
